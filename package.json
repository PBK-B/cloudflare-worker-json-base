{
	"name": "cloudflare-worker-json-base",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "npm run build:shared && npm run build:web && npm run build:api",
		"build:shared": "npm run build --workspace @jsonbase/shared",
		"build:web": "npm run build --workspace @jsonbase/web",
		"build:api": "npm run build --workspace @jsonbase/api",
		"dev:api": "npm run dev --workspace @jsonbase/api",
		"dev:web": "npm run dev --workspace @jsonbase/web",
		"type-check": "npm run type-check --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"test:deploy-cli": "npx jest --config jest.deploy-cli.config.json",
		"build:deploy-cli": "tsc -p tsconfig.json --outDir .deploy-temp",
		"deploy": "npm run build:deploy-cli && node .deploy-temp/deploy-cli.js deploy",
		"deploy:doctor": "npm run build:deploy-cli && node .deploy-temp/deploy-cli.js doctor",
		"deploy:print": "npm run build:deploy-cli && node .deploy-temp/deploy-cli.js print-config",
		"auto-deploy": "npm run deploy",
		"clean": "rm -rf .deploy-temp dist apps/api/dist apps/web/dist packages/shared/dist"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260124.0",
		"@rsuite/icons": "^1.4.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/inquirer": "^9.0.9",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.0.10",
		"@types/react": "^19.2.9",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"axios-hooks": "^5.1.1",
		"chalk": "^5.0.0",
		"commander": "^12.0.0",
		"html-to-image": "^1.11.13",
		"i18next-cli": "^1.58.1",
		"identity-obj-proxy": "^3.0.0",
		"inquirer": "^9.0.0",
		"jest": "^30.2.0",
		"jest-environment-jsdom": "^30.4.1",
		"playwright": "^1.60.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-router-dom": "^7.13.0",
		"sharp": "^0.34.5",
		"ts-jest": "^29.4.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"wrangler": "^4.60.0"
	}
}
